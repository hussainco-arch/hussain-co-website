PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# true = local preview, inquiries disappear on restart and are not emailed.
# false = MongoDB persistence, MONGODB_URI must connect successfully.
DEMO_MODE=true
MONGODB_URI=mongodb://127.0.0.1:27017/hussain_co
# Exact trusted reverse-proxy hop count on deployment (usually 1). Never blindly use true.
TRUST_PROXY=0
